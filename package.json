    "@vitejs/plugin-react": "^5.2.0",
    "fake-indexeddb": "^6.0.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "vite": "^7.3.7",
    "vite-plugin-pwa": "^1.3.0",
